{
  "name": "pocket-overlord",
  "version": "312",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "changeset": "changeset",
    "test": "vitest run --exclude tests/benchmark.test.ts",
    "test:watch": "vitest --exclude tests/benchmark.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "vitest run tests/benchmark.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/read": "^1.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vite": "~7.3.1",
    "vitest": "~4.1.12"
  }
}
